---
import Base from '../layouts/Base.astro';

const page = {
  path: '/404',
  title: 'Page not found · Colliedesk',
  description: 'The page you asked for does not exist. Try the home page, the docs or the llms.txt index of every page.',
  jsonLd: [],
};
---
<Base page={page} notFound>
  <section class="page-hero"><div class="wrap"><p class="eyebrow">404</p><h1>This ticket wandered off</h1><p class="lede">The page you asked for does not exist. Try <a href="/">the home page</a>, <a href="/docs">the docs</a> or <a href="/llms.txt">the index of every page</a>.</p></div></section>
</Base>
